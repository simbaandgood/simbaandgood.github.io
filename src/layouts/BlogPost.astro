---
import Base from './Base.astro';
import { defaultLocale } from '../i18n/locales';
const { frontmatter, lang = defaultLocale, path = Astro.url.pathname } = Astro.props;
const date = new Date(frontmatter.pubDate).toLocaleDateString(lang === 'en' ? 'en-US' : lang, { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate,
  author: { '@type': 'Organization', name: 'Simba & Good' },
  publisher: { '@type': 'Organization', name: 'Simba & Good' },
};
---
<Base title={`${frontmatter.title} — Simba & Good`} description={frontmatter.description} path={path} lang={lang} type="article" structuredData={articleSchema}>
  <article class="post">
    <div class="narrow">
      <a class="back" href={lang === defaultLocale ? '/stories' : `/${lang}/stories`}>&larr; {frontmatter.backLabel ?? 'All stories'}</a>
      <span class="eyebrow">{frontmatter.eyebrow ?? 'Stories'}</span>
      <h1>{frontmatter.title}</h1>
      <p class="meta">{date}</p>
      <div class="body"><slot /></div>
    </div>
  </article>
  <style>
    .post{padding:52px 0 80px}
    .narrow{max-width:720px;margin:0 auto;padding:0 24px}
    .back{color:var(--muted);text-decoration:none;font-size:14px;font-weight:500}
    .post h1{font-size:clamp(32px,4.6vw,48px);margin:14px 0 8px}
    .meta{color:var(--muted);font-size:14px;margin-bottom:30px}
    .body{font-size:17px;line-height:1.7;color:#37423b}
    .body :global(h2){font-family:var(--font-heading);font-size:26px;margin:34px 0 10px;color:var(--ink);font-weight:500}
    .body :global(h3){font-family:var(--font-heading);font-size:19px;margin:30px 0 8px;color:var(--ink);font-weight:500}
    .body :global(p){margin:0 0 18px}
    .body :global(a){color:var(--forest)}
    .body :global(ul){padding-left:20px}
    .body :global(li){margin:6px 0}
    .body :global(blockquote){margin:18px 0;padding:4px 0 4px 20px;border-left:3px solid var(--line);color:var(--muted)}
    .body :global(blockquote p:last-child){margin-bottom:0}
  </style>
</Base>

---
import { defaultLocale, localizedPath } from '../i18n/locales';

const { lang = defaultLocale } = Astro.props;
const seasonsHref = localizedPath('/seasons', lang);
const shopHref = localizedPath('/shop', lang);
const brandsHref = localizedPath('/for-brands', lang);
const venuesHref = localizedPath('/for-venues', lang);
const missionHref = localizedPath('/welfare-plan', lang);
const storiesHref = localizedPath('/stories', lang);
const contactHref = localizedPath('/contact', lang);

const copy = {
  en: {
    tagline: 'Better care for the pets we love — and real support for the ones still waiting.',
    whatWeDo: 'What we do', seasons: 'Seasons app', shop: 'Shop for Good', brands: 'For brands', venues: 'For venues',
    more: 'More', mission: 'Mission', stories: 'Stories',
    company: 'Company', contact: 'Contact', privacy: 'Privacy', terms: 'Terms',
    copyright: '© 2026 Simba & Good. 70% of profits to animal welfare — that’s the dream we’re building toward.',
  },
  es: {
    tagline: 'Mejor cuidado para las mascotas que amamos — y ayuda real para las que aún esperan.',
    whatWeDo: 'Qué hacemos', seasons: 'App Seasons', shop: 'Shop for Good', brands: 'Para marcas', venues: 'Para locales',
    more: 'Más', mission: 'Misión', stories: 'Historias',
    company: 'Empresa', contact: 'Contacto', privacy: 'Privacidad', terms: 'Términos',
    copyright: '© 2026 Simba & Good. Nuestra meta: el 70% de las ganancias para el bienestar animal.',
  },
  pt: {
    tagline: 'Mais cuidado para os pets que amamos — e apoio real para os que ainda esperam.',
    whatWeDo: 'O que fazemos', seasons: 'App Seasons', shop: 'Shop for Good', brands: 'Para marcas', venues: 'Para espaços',
    more: 'Mais', mission: 'Missão', stories: 'Histórias',
    company: 'Empresa', contact: 'Contato', privacy: 'Privacidade', terms: 'Termos',
    copyright: '© 2026 Simba & Good. Nossa meta: 70% dos lucros para o bem-estar animal.',
  },
  th: {
    tagline: 'ดูแลสัตว์เลี้ยงที่เรารักให้ดียิ่งขึ้น — และช่วยเหลือตัวที่ยังรอคอยอยู่จริง ๆ',
    whatWeDo: 'สิ่งที่เราทำ', seasons: 'แอป Seasons', shop: 'Shop for Good', brands: 'สำหรับแบรนด์', venues: 'สำหรับสถานที่',
    more: 'เพิ่มเติม', mission: 'พันธกิจ', stories: 'เรื่องราว',
    company: 'บริษัท', contact: 'ติดต่อเรา', privacy: 'ความเป็นส่วนตัว', terms: 'ข้อกำหนด',
    copyright: '© 2026 Simba & Good. เป้าหมายของเรา: 70% ของกำไรเพื่อสวัสดิภาพสัตว์',
  },
  de: {
    tagline: 'Bessere Pflege für die Haustiere, die wir lieben — und echte Hilfe für die, die noch warten.',
    whatWeDo: 'Was wir tun', seasons: 'Seasons App', shop: 'Shop for Good', brands: 'Für Marken', venues: 'Für Standorte',
    more: 'Mehr', mission: 'Mission', stories: 'Geschichten',
    company: 'Unternehmen', contact: 'Kontakt', privacy: 'Datenschutz', terms: 'AGB',
    copyright: '© 2026 Simba & Good. Unser Ziel: 70% der Gewinne für Tierschutz.',
  },
  fr: {
    tagline: 'De meilleurs soins pour les animaux que nous aimons — et une aide réelle pour ceux qui attendent encore.',
    whatWeDo: 'Ce que nous faisons', seasons: 'App Seasons', shop: 'Shop for Good', brands: 'Pour les marques', venues: 'Pour les lieux',
    more: 'Plus', mission: 'Mission', stories: 'Histoires',
    company: 'Entreprise', contact: 'Contact', privacy: 'Confidentialité', terms: 'Conditions',
    copyright: '© 2026 Simba & Good. Notre objectif : 70% des bénéfices pour le bien-être animal.',
  },
  it: {
    tagline: 'Più cura per gli animali che amiamo — e aiuto vero per chi sta ancora aspettando.',
    whatWeDo: 'Cosa facciamo', seasons: 'App Seasons', shop: 'Shop for Good', brands: 'Per i brand', venues: 'Per i locali',
    more: 'Altro', mission: 'Missione', stories: 'Storie',
    company: 'Azienda', contact: 'Contatti', privacy: 'Privacy', terms: 'Termini',
    copyright: '© 2026 Simba & Good. Il nostro obiettivo: il 70% dei profitti per il benessere animale.',
  },
} as const;

const t = copy[lang as keyof typeof copy] ?? copy.en;
const home = localizedPath('/', lang);
---
<footer>
  <div class="wrap">
    <div class="foot-cols">
      <div>
        <a class="brand" href={home}>Simba <span>&amp;</span> Good</a>
        <p>{t.tagline}</p>
      </div>
      <div>
        <h4>{t.whatWeDo}</h4>
        <a href={seasonsHref}>{t.seasons}</a>
        <a href={shopHref}>{t.shop}</a>
        <a href={brandsHref}>{t.brands}</a>
        <a href={venuesHref}>{t.venues}</a>
      </div>
      <div>
        <h4>{t.more}</h4>
        <a href={missionHref}>{t.mission}</a>
        <a href={storiesHref}>{t.stories}</a>
      </div>
      <div>
        <h4>{t.company}</h4>
        <a href={contactHref}>{t.contact}</a>
        <a href="/privacy">{t.privacy}</a>
        <a href="/terms">{t.terms}</a>
      </div>
    </div>
    <div class="copyright">{t.copyright}</div>
  </div>
</footer>

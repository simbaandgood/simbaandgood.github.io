---
---
<nav>
  <div class="wrap nav-in">
    <a class="brand" href="/">Simba <span>&amp;</span> Good</a>
    <button class="menu-btn" aria-label="Toggle menu" aria-expanded="false">&#9776;</button>
    <div class="nav-links">
      <a href="/#stages">How it works</a>
      <a href="/welfare-plan">Mission</a>
      <a href="/shop">Shop</a>
      <a href="/stories">Stories</a>
      <a href="/for-brands">For brands</a>
      <a class="btn btn-primary" href="/contact">Get early access</a>
    </div>
  </div>
</nav>
<script>
  const btn = document.querySelector('.menu-btn');
  const links = document.querySelector('.nav-links');
  btn?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

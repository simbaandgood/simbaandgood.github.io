---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const sections = [
  {
    key: 'pet-life',
    label: 'Pet life',
    title: 'Helping you take better care of the animals you love.',
  },
  {
    key: 'animal-welfare',
    label: 'Animal welfare',
    title: 'Understanding the animals who need us.',
  },
  {
    key: 'building',
    label: 'Building Simba & Good',
    title: 'A look behind the scenes.',
  },
];

const generalPosts = remainingPosts.filter(
  (post) =>
    !['pet-life', 'animal-welfare', 'building'].some((tag) =>
      post.data.tags?.includes(tag)
    )
);
---

<Base
  title="Stories — Simba & Good"
  description="Stories, ideas, and things we're learning about pets, animal welfare, and building Simba & Good."
  path="/stories"
>
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow">Stories</span>

      <h1>Things we're learning along the way.</h1>

      <p>
        From living with dogs to building Simba & Good, these are our stories,
        ideas, and lessons along the way.
      </p>
    </div>
  </header>

  {featuredPost && (
    <section class="wrap featured-section">
      <a class="featured-post" href={`/stories/${featuredPost.id}`}>
        <div class="featured-media">
          <div class="featured-media-inner">
            <span class="eyebrow">Our story</span>
            <span class="media-placeholder">Story image</span>
          </div>
        </div>

        <div class="featured-content">
          <span class="date">
            {featuredPost.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </span>

          <h2>{featuredPost.data.title}</h2>

          <p>{featuredPost.data.description}</p>

          <span class="read">Read the story &rarr;</span>
        </div>
      </a>
    </section>
  )}

  {sections.map((section) => {
    const sectionPosts = remainingPosts.filter((post) =>
      post.data.tags?.includes(section.key)
    );

    if (!sectionPosts.length) return null;

    return (
      <section class="story-section wrap">
        <div class="section-head">
          <span class="eyebrow">{section.label}</span>
          <h2>{section.title}</h2>
        </div>

        <div class="post-grid">
          {sectionPosts.map((post) => (
            <a class="post-card" href={`/stories/${post.id}`}>
              <span class="date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>

              <h3>{post.data.title}</h3>

              <p>{post.data.description}</p>

              <span class="read">Read &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    );
  })}

  {generalPosts.length > 0 && (
    <section class="story-section wrap">
      <div class="section-head">
        <span class="eyebrow">Stories</span>
        <h2>More from Simba & Good.</h2>
      </div>

      <div class="post-grid">
        {generalPosts.map((post) => (
          <a class="post-card" href={`/stories/${post.id}`}>
            <span class="date">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </span>

            <h3>{post.data.title}</h3>

            <p>{post.data.description}</p>

            <span class="read">Read &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mission-cta">
    <div class="wrap">
      <div class="mission-cta-inner">
        <span class="eyebrow">Want to help?</span>

        <h2>We're building this together.</h2>

        <p>
          We're building Simba & Good to make pet care easier and animal
          welfare more sustainable.
        </p>

        <a class="btn btn-primary" href="/contact">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <style>
    .page-head {
      padding: 64px 0 42px;
    }

    .page-head h1 {
      font-size: clamp(38px, 6vw, 60px);
      line-height: 1.05;
      letter-spacing: -0.03em;
      max-width: 12ch;
      margin: 16px 0 18px;
    }

    .page-head p {
      color: var(--muted);
      font-size: 18px;
      line-height: 1.6;
      max-width: 52ch;
      margin: 0;
    }

    /* Featured story */

    .featured-section {
      padding: 20px 0 80px;
    }

    .featured-post {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      background: var(--sage);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      text-decoration: none;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }

    .featured-post:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px -18px rgba(35, 75, 62, 0.25);
    }

    .featured-media {
      min-height: 430px;
      background: var(--forest);
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .featured-media-inner {
      text-align: center;
      padding: 32px;
    }

    .featured-media .eyebrow {
      color: var(--gold);
    }

    .media-placeholder {
      display: block;
      margin-top: 12px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 14px;
    }

    .featured-content {
      padding: clamp(30px, 5vw, 56px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .date {
      font-size: 12px;
      color: var(--gold);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .featured-content h2 {
      font-size: clamp(30px, 4vw, 46px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: var(--ink);
      margin: 14px 0 16px;
      font-weight: 500;
    }

    .featured-content p {
      color: var(--muted);
      font-size: 16px;
      line-height: 1.65;
      margin: 0;
      max-width: 42ch;
    }

    .featured-content .read {
      color: var(--forest);
      font-weight: 600;
      font-size: 14px;
      margin-top: 24px;
    }

    /* Story sections */

    .story-section {
      padding: 0 0 76px;
    }

    .section-head {
      margin-bottom: 24px;
    }

    .section-head h2 {
      font-size: clamp(25px, 3vw, 34px);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 10px 0 0;
      font-weight: 500;
      max-width: 28ch;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .post-card {
      background: var(--sage);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      min-height: 260px;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .post-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px -18px rgba(35, 75, 62, 0.2);
      border-color: var(--forest);
    }

    .post-card h3 {
      font-size: 22px;
      line-height: 1.2;
      margin: 12px 0 10px;
      color: var(--ink);
      font-weight: 500;
    }

    .post-card p {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
      margin: 0;
    }

    .read {
      color: var(--forest);
      font-weight: 600;
      font-size: 14px;
      display: inline-block;
      margin-top: auto;
      padding-top: 22px;
    }

    /* Mission CTA */

    .mission-cta {
      padding: 20px 0 90px;
    }

    .mission-cta-inner {
      background: var(--forest);
      border-radius: var(--radius);
      padding: clamp(36px, 6vw, 64px);
      text-align: center;
    }

    .mission-cta-inner .eyebrow {
      color: var(--gold);
    }

    .mission-cta h2 {
      color: #fff;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.1;
      letter-spacing: -0.025em;
      margin: 14px auto 12px;
      font-weight: 500;
    }

    .mission-cta p {
      color: rgba(255, 255, 255, 0.78);
      max-width: 48ch;
      margin: 0 auto;
      line-height: 1.6;
    }

    .mission-cta .btn {
      margin-top: 24px;
      background: #fff;
      color: var(--forest);
    }

    .mission-cta .btn:hover {
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.15);
    }

    @media (max-width: 980px) {
      .featured-post {
        grid-template-columns: 1fr;
      }

      .featured-media {
        min-height: 320px;
      }

      .post-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .page-head {
        padding: 48px 0 30px;
      }

      .featured-section {
        padding-bottom: 64px;
      }

      .featured-media {
        min-height: 260px;
      }

      .post-grid {
        grid-template-columns: 1fr;
      }

      .post-card {
        min-height: 220px;
      }

      .story-section {
        padding-bottom: 60px;
      }
    }
  </style>
</Base>
---
import Base from '../../layouts/Base.astro';

const title = 'Seasons — l’appli du cycle de vie de votre animal, par Simba & Good';
const description = 'Seasons vous accompagne à chaque étape de la vie de votre animal avec des soins adaptés à sa race et son âge — vaccins, nutrition, étapes clés — et chaque abonnement contribue au bien-être animal.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Seasons',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'iOS',
  description: 'A pet lifecycle app that adapts to your pet\u2019s breed and age, guiding you through vaccinations, nutrition, health checks, and milestones at every stage of life.',
  offers: [
    { '@type': 'Offer', name: 'Solo', price: '5.99', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Family', price: '11.99', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Supporter', price: '23.99', priceCurrency: 'USD' },
  ],
  publisher: { '@type': 'Organization', name: 'Simba & Good' },
};
---
<Base title={title} description={description} path="/seasons" lang="fr" structuredData={appSchema}>
  <header class="hero"><div class="wrap hero-grid">
    <div>
      <span class="eyebrow">Seasons — l’appli du cycle de vie de votre animal, par Simba &amp; Good</span>
      <h1>Soyez présent à chaque étape de sa vie.</h1>
      <p class="lead">Seasons apprend la race et l’âge de votre animal, puis vous guide sur l’essentiel à chaque étape — vaccins, nutrition, bilans de santé et les petites étapes clés entre les deux.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://tally.so/r/q48YO2">Accès anticipé</a>
        <a class="btn btn-ghost" href="#stages">Voir comment ça marche</a>
      </div>
      <p class="hero-note">🐾 Notre objectif : reverser 70% des bénéfices au bien-être animal.</p>
    </div>
    <div class="hero-img icon-frame">
      <img src="/images/seasons-app-icon.png" alt="The Seasons app icon" />
    </div>
  </div></header>

  <section class="arc" id="stages"><div class="wrap">
    <span class="eyebrow">Une appli, toute sa vie</span>
    <h2>Un accompagnement qui grandit avec lui.</h2>
    <p class="sub">Un chiot, un adulte et un senior ont besoin de soins complètement différents — et un dogue allemand ne vieillit pas du tout comme un chihuahua. Seasons s’adapte à la race et à l’âge de votre animal, pour que vous sachiez toujours ce qui vient ensuite.</p>
    <div class="track">
      <div class="stage"><span class="dot"></span><div class="age">8 semaines</div><h3>Nouvelle arrivée</h3><p>Premiers vaccins, choix du vétérinaire, et bien poser les bases dès le premier jour.</p></div>
      <div class="stage"><span class="dot"></span><div class="age">6 mois</div><h3>Construire des habitudes</h3><p>Éducation, changements alimentaires, et le bon moment pour la stérilisation selon la race.</p></div>
      <div class="stage"><span class="dot"></span><div class="age">1–7 ans</div><h3>Les belles années</h3><p>Rappels de vaccins, soins dentaires, et suivi du poids pour qu’il s’épanouisse.</p></div>
      <div class="stage"><span class="dot"></span><div class="age">7 ans et +</div><h3>Soins seniors</h3><p>Plus tôt pour les grandes races — dépistages, mobilité et confort.</p></div>
      <div class="stage"><span class="dot"></span><div class="age">Une vie pleine</div><h3>Chaque souvenir</h3><p>Dossiers, étapes clés, et un historique qui reste avec lui pour toujours.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <span class="eyebrow">Comment ça marche</span>
    <h2>Configurez une fois. On s’occupe du calendrier.</h2>
    <div class="steps">
      <div class="step"><div class="n">01</div><h3>Ajoutez votre animal</h3><p>Race, date de naissance et quelques détails. C’est tout ce dont nous avons besoin pour commencer.</p></div>
      <div class="step"><div class="n">02</div><h3>Recevez un plan sur mesure</h3><p>Rappels et conseils ajustés à sa race et son âge exacts — jamais génériques.</p></div>
      <div class="step"><div class="n">03</div><h3>Faites le bien, sans effort</h3><p>Une part de ce que Seasons gagne revient aux animaux qui en ont besoin.</p></div>
    </div>
  </div></section>

  <section class="pricing" id="pricing"><div class="wrap">
    <span class="eyebrow">Tarification simple</span>
    <h2>Un abonnement. Toute sa vie couverte.</h2>
    <p class="psub">Chaque formule commence par un essai gratuit de 7 jours. Résiliable à tout moment.</p>
    <div class="plans">
      <div class="plan">
        <div class="pname">Solo</div>
        <div class="pprice">5,99 $<span>/mois</span></div>
        <div class="pmeta">Un chien</div>
        <ul><li>Plan de soins complet selon race et âge</li><li>Rappels intelligents à chaque étape</li><li>Dossiers de santé et de vaccination</li></ul>
      </div>
      <div class="plan feature">
        <div class="pname">Family</div>
        <div class="pprice">11,99 $<span>/mois</span></div>
        <div class="pmeta">Jusqu’à 5 chiens · partagé en famille</div>
        <ul><li>Tout ce qu’il y a dans Solo</li><li>Jusqu’à cinq chiens</li><li>Partagez avec tout le foyer</li></ul>
      </div>
      <div class="plan">
        <div class="pname">Supporter</div>
        <div class="pprice">23,99 $<span>/mois</span></div>
        <div class="pmeta">Jusqu’à 5 chiens · donne plus</div>
        <ul><li>Tout ce qu’il y a dans Family</li><li>Finance nettement plus de bien-être animal</li><li>Badge Supporter et points d’impact</li></ul>
      </div>
    </div>
    <p class="pnote">🐾 Chaque formule contribue au bien-être animal — Supporter donne simplement plus.</p>
  </div></section>

  <section class="mission" id="mission"><div class="wrap mission-grid">
    <div>
      <span class="eyebrow">La mission</span>
      <h2>Des soins quotidiens qui redonnent.</h2>
      <p>Seasons existe pour faciliter les soins de votre animal — et transformer une entreprise saine en un soutien réel pour les animaux qui n’ont personne. Sauvetage, soins vétérinaires et replacement des animaux errants et de refuge. Chaque abonnement finance ce don dès le premier jour, et cela ne fait que grandir.</p>
      <span class="pill">🐾 Rapporté en toute transparence, chaque année.</span>
      <div class="mission-link"><a href="/fr/welfare-plan">Lire notre plan de bien-être animal complet →</a></div>
    </div>
    <div>
      <div class="give">70%</div>
      <div class="give-label">c’est notre objectif pour la part des bénéfices consacrée au bien-être animal, au fil du temps.</div>
    </div>
  </div></section>

  <section id="join"><div class="cta">
    <h2>Soyez présent pour toute sa vie.</h2>
    <p>Rejoignez la liste d’accès anticipé et nous vous informerons dès que Seasons sera prêt.</p>
    <a class="btn btn-primary" href="https://tally.so/r/q48YO2">Accès anticipé</a>
  </div></section>

  <style>
    .hero{padding:72px 0 40px}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
    .hero h1{font-size:clamp(38px,5.4vw,64px);margin:18px 0 20px}
    .hero .lead{font-size:19px;color:var(--muted);max-width:32ch;margin-bottom:30px}
    .hero-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
    .hero-note{font-size:13.5px;color:var(--muted);margin-top:18px}
    .hero-img{position:relative}
    .hero-img img{width:100%;border-radius:var(--radius);aspect-ratio:4/5;object-fit:cover;box-shadow:0 30px 60px -30px rgba(23,50,41,.45)}
    .hero-img.icon-frame{max-width:380px;margin:0 auto}
    .hero-img.icon-frame img{aspect-ratio:1/1;object-fit:cover;border-radius:22%}
    .arc{background:var(--forest-deep);color:#F3F0E8;padding:74px 0;margin-top:36px}
    .arc h2{color:#fff;font-size:clamp(28px,3.6vw,40px);max-width:16ch}
    .arc .eyebrow{color:var(--gold)}
    .arc .sub{color:#B9C6BC;margin:16px 0 46px;max-width:52ch;font-size:16.5px}
    .track{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:18px}
    .track:before{content:"";position:absolute;left:6%;right:6%;top:11px;height:2px;background:linear-gradient(90deg,#3a6152,var(--gold),#3a6152)}
    .stage{position:relative;padding-top:34px}
    .dot{position:absolute;top:4px;left:0;width:16px;height:16px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 5px rgba(201,146,66,.18)}
    .stage .age{font-family:var(--font-heading);font-size:15px;color:var(--gold);font-weight:600}
    .stage h3{font-size:17px;color:#fff;margin:4px 0 6px;font-weight:500}
    .stage p{font-size:13.5px;color:#AEBDB1;line-height:1.5}
    .section{padding:80px 0}
    .section h2{font-size:clamp(28px,3.6vw,42px);max-width:18ch}
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:48px}
    .step{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px}
    .step .n{font-family:var(--font-heading);font-size:22px;color:var(--gold);font-weight:600}
    .step h3{font-size:19px;margin:14px 0 8px;font-weight:500}
    .step p{color:var(--muted);font-size:15px}
    .pricing{padding:80px 0}
    .pricing h2{font-size:clamp(28px,3.6vw,42px);max-width:18ch}
    .psub{color:var(--muted);margin:14px 0 40px;font-size:16.5px}
    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .plan{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column}
    .plan.feature{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .pname{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .pprice{font-family:var(--font-heading);font-size:40px;font-weight:600;margin:12px 0 2px}
    .pprice span{font-size:16px;color:var(--muted)}
    .plan.feature .pprice span{color:#B9C6BC}
    .pmeta{font-size:14px;color:var(--muted);margin-bottom:16px}
    .plan.feature .pmeta{color:#B9C6BC}
    .plan ul{list-style:none;padding:0;margin:8px 0 0}
    .plan li{font-size:14.5px;color:var(--muted);padding:7px 0 7px 22px;position:relative}
    .plan.feature li{color:#CDD9CF}
    .plan li:before{content:"🐾";position:absolute;left:0;font-size:11px;top:8px}
    .pnote{text-align:center;color:var(--muted);font-size:14.5px;margin-top:30px}
    .mission{background:var(--sage);padding:78px 0}
    .mission-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
    .mission h2{font-size:clamp(26px,3.4vw,38px);max-width:16ch}
    .mission p{color:var(--muted);margin-top:18px;font-size:16.5px;max-width:46ch}
    .give{font-family:var(--font-heading);font-size:clamp(40px,6vw,72px);color:var(--forest);font-weight:600;line-height:1;margin-top:8px}
    .give-label{color:var(--muted);font-size:15px;margin-top:6px}
    .mission .pill{display:inline-flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:14px;font-weight:500;margin-top:24px}
    .mission-link{margin-top:22px}
    .mission-link a{color:var(--forest);font-weight:600;text-decoration:none}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:56px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(28px,3.6vw,42px);max-width:20ch;margin:0 auto}
    .cta p{color:#C4D2C7;margin:16px auto 30px;max-width:44ch}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .cta .btn-primary:hover{box-shadow:0 8px 22px rgba(201,146,66,.35)}
    @media (max-width:860px){
      .hero-grid,.mission-grid{grid-template-columns:1fr;gap:34px}
      .hero{padding:44px 0 20px}.hero-img{order:-1}
      .steps,.plans{grid-template-columns:1fr}
      .track{grid-template-columns:1fr 1fr;gap:26px 18px}.track:before{display:none}
    }
  </style>
</Base>

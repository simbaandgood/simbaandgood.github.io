    <a class="btn btn-primary" href="/">Retour à l’accueil</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>

---
import Base from '../../layouts/Base.astro';

const title = 'Simba & Good pour les marques — Marketing, produit et IA pour entreprises animalières';
const description = "Simba & Good est le pôle agence qui aide les entreprises animalières à se développer : marketing, produit et design, et une offre IA neutre vis-à-vis des prestataires, à commencer par un diagnostic de maturité IA à 999 $.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Marketing, Product & Design, and AI Consulting for Pet Businesses',
  provider: { '@type': 'Organization', name: 'Simba & Good' },
  areaServed: 'Global',
  audience: { '@type': 'Audience', audienceType: 'Pet industry businesses' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI Services for Pet Businesses',
    itemListElement: [
      { '@type': 'Offer', name: 'AI Readiness Assessment', price: '999', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'AI Concierge (monthly)', price: '1500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Process Redesign', price: '3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Automation Builds', priceRange: '$2000-$3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Knowledge Systems', priceRange: '$3500+', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Custom Assistants', priceRange: '$4000-$6000', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Full AI Implementation', priceRange: '$10000-$18000+', priceCurrency: 'USD' },
    ],
  },
};
---
<Base title={title} description={description} path="/for-brands" lang="fr" structuredData={serviceSchema}>
  <header class="hero"><div class="wrap">
    <span class="eyebrow">Pour les marques · L’agence Simba &amp; Good</span>
    <h1>Marketing, produit et IA — conçus pour le secteur animalier.</h1>
    <p>Nous aidons les entreprises animalières à grandir, se moderniser et avoir de l’allure — des cliniques et toiletteurs à l’alimentation, au commerce et à la pet-tech. Piloté par des personnes produit et design qui adorent ce secteur.</p>
    <div class="who">
      <span>Vétérinaires et cliniques</span><span>Toiletteurs et pension</span><span>Alimentation et D2C</span>
      <span>Commerce animalier</span><span>Pet-tech</span><span>Refuges et sauvetages</span>
    </div>
  </div></header>

  <section class="disc"><div class="wrap">
    <h2>Trois choses que nous faisons bien.</h2>
    <p>Choisissez-en un, ou combinez-les. Chaque collaboration a un périmètre mensuel fixe — sans factures surprises, sans engagement ouvert.</p>
  </div></section>

  <section class="wrap">
    <div class="tiers">
      <div class="tier">
        <span class="kind">Marketing · Essentiel</span>
        <h3>Restez visible</h3>
        <div class="price">$1,000<span style="font-size:16px">/mo</span></div>
        <span class="per">Mensuel reconductible · résiliable à tout moment</span>
        <ul><li>Contenu social, planifié et publié</li><li>Campagne ou promotion mensuelle</li><li>Support design léger selon vos besoins</li><li>Récapitulatif de performance mensuel simple</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Réserver un appel</a>
      </div>
      <div class="tier feature">
        <span class="kind">Marketing · Croissance</span>
        <h3>Grandir avec intention</h3>
        <div class="price">$3,000<span style="font-size:16px">/mo</span></div>
        <span class="per">La plus populaire pour développer sa marque</span>
        <ul><li>Moteur de contenu complet sur tous les canaux</li><li>Landing pages et design de campagnes</li><li>Assets de marque et direction créative</li><li>Email / marketing de cycle de vie</li><li>Session de stratégie mensuelle</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Réserver un appel</a>
      </div>
      <div class="tier">
        <span class="kind">Produit et design</span>
        <h3>Construisez quelque chose de grand</h3>
        <div class="price">à partir de 5 000 $<span style="font-size:16px">/mois</span></div>
        <span class="per">Pour la pet-tech et les marques orientées produit</span>
        <ul><li>UX et UI pour applis et sites web</li><li>Stratégie produit et roadmap</li><li>Design systems et prototypes</li><li>Direction produit/design senior</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Réserver un appel</a>
      </div>
    </div>

    <div class="note"><b>Travailler avec nous finance aussi la mission.</b> &nbsp;Une part de tout ce que l’agence gagne va au bien-être animal — faire grandir votre entreprise aide donc des animaux au-delà de vos propres clients.</div>
  </section>

  <section class="ai-section"><div class="wrap">
    <span class="eyebrow">IA pour entreprises animalières</span>
    <h2>Commencez par le diagnostic. Laissez-le révéler les projets à plus forte valeur.</h2>
    <p class="ai-sub">Une offre neutre vis-à-vis des prestataires — nous construisons avec l’outil qui convient, pour que vous ne soyez jamais dépendant d’un seul fournisseur. Chaque collaboration laisse à votre équipe des outils IA qu’elle possède et peut continuer à utiliser sans nous.</p>

    <div class="ai-wedge">
      <span class="ai-n">01</span>
      <div>
        <h3>Diagnostic de maturité IA <span class="star">★ commencez ici</span></h3>
        <p>Une session de travail de 45 minutes → une carte priorisée de 3 à 7 points où l’IA fait gagner à votre équipe des heures réelles (réservations, communication client, inventaire, contenu, avis). La plupart des diagnostics révèlent deux ou trois projets à plus forte valeur.</p>
      </div>
      <div class="ai-price">999 $<span>forfait, déduit de la prochaine étape</span></div>
    </div>

    <div class="ai-ladder">
      <div class="ai-row"><span class="ai-n">02</span><div class="ai-name">AI Concierge <small>forfait</small></div><div class="ai-p">1 500 $<small>/mois</small></div><div class="ai-d">Deux appels de 45 min par mois, transformés en assistants IA réutilisables que votre équipe utilise vraiment.</div></div>
      <div class="ai-row"><span class="ai-n">03</span><div class="ai-name">Refonte de processus</div><div class="ai-p">3 500 $</div><div class="ai-d">Nous prenons un processus long et pénible et le simplifions. Une clinique : admission en 25 étapes → 10.</div></div>
      <div class="ai-row"><span class="ai-n">04</span><div class="ai-name">Automatisations</div><div class="ai-p">2K–3,5K $</div><div class="ai-d">Nous connectons les outils que vous utilisez déjà en flux automatisés — de la réservation au suivi, automatiquement.</div></div>
      <div class="ai-row"><span class="ai-n">05</span><div class="ai-name">Systèmes de connaissance</div><div class="ai-p">3,5K $+</div><div class="ai-d">Nous transformons des informations dispersées — emails, protocoles, catalogues — en réponses instantanées, à l’image de votre marque.</div></div>
      <div class="ai-row"><span class="ai-n">06</span><div class="ai-name">Assistants sur mesure</div><div class="ai-p">4K–6K $</div><div class="ai-d">Des outils IA sur mesure conçus pour votre entreprise. Une tâche de 45 minutes, ramenée à 5.</div></div>
      <div class="ai-row"><span class="ai-n">07</span><div class="ai-name">Déploiement IA complet</div><div class="ai-p">10K–18K $+</div><div class="ai-d">Assistants, automatisations et systèmes de connaissance déployés dans toute l’entreprise, avec formation.</div></div>
    </div>

    <div class="ai-model">
      <h4>Le modèle</h4>
      <ol><li>Le diagnostic sert de base.</li><li>On se concentre sur les heures économisées, pas sur les heures travaillées.</li><li>Vous êtes propriétaire de ce que nous construisons — aucun verrouillage.</li></ol>
    </div>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Réserver le diagnostic à 999 $</a>
  </div></section>

  <section><div class="cta">
    <h2>Faisons grandir votre entreprise animalière.</h2>
    <p>Parlez-nous de votre projet. Nous reviendrons avec un plan et un tarif mensuel fixe.</p>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Réserver un appel</a>
  </div></section>

  <style>
    .hero{padding:72px 0 30px}
    .hero .eyebrow{color:var(--gold)}
    .hero h1{font-size:clamp(38px,5.2vw,60px);margin:16px 0 20px;max-width:16ch}
    .hero p{color:var(--muted);font-size:19px;max-width:50ch}
    .who{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
    .who span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13.5px;color:var(--muted)}
    .disc{padding:22px 0 8px}
    .disc h2{font-size:clamp(26px,3.4vw,38px)}
    .disc p{color:var(--muted);margin-top:12px;max-width:56ch;font-size:16.5px}
    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:38px 0 20px}
    .tier{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column}
    .tier.feature{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .tier .kind{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .tier h3{font-size:23px;margin:10px 0 6px;font-weight:500}
    .tier.feature h3{color:#fff}
    .tier .price{font-family:var(--font-heading);font-size:34px;font-weight:600;margin:8px 0 2px}
    .tier .per{font-size:13.5px;color:var(--muted)}
    .tier.feature .per{color:#B9C6BC}
    .tier ul{list-style:none;padding:0;margin:20px 0 0;flex:1}
    .tier li{font-size:14.5px;color:var(--muted);padding:7px 0 7px 22px;position:relative}
    .tier.feature li{color:#CDD9CF}
    .tier li:before{content:"🐾";position:absolute;left:0;font-size:12px;top:8px}
    .tier .btn{margin-top:22px;text-align:center}
    .tier.feature .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .note{background:var(--sage);border-radius:var(--radius);padding:26px 30px;margin:16px 0 40px;font-size:15.5px;color:var(--muted)}
    .note b{color:var(--ink);font-family:var(--font-heading)}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:52px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(26px,3.4vw,40px);max-width:20ch;margin:0 auto}
    .cta p{color:#C4D2C7;margin:14px auto 28px;max-width:46ch}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .ai-section{padding:20px 0 80px}
    .ai-section h2{font-size:clamp(26px,3.4vw,38px);max-width:22ch;margin-top:10px}
    .ai-sub{color:var(--muted);margin:14px 0 36px;max-width:56ch;font-size:16px}
    .ai-wedge{background:var(--forest-deep);color:#fff;border-radius:var(--radius);padding:26px 30px;display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;margin-bottom:14px}
    .ai-wedge .ai-n{font-family:var(--font-heading);font-size:22px;color:var(--gold);font-weight:600}
    .ai-wedge h3{color:#fff;font-size:19px;font-weight:500;margin:0 0 6px}
    .ai-wedge .star{color:var(--gold);font-size:12px;font-weight:600;letter-spacing:.05em;margin-left:6px}
    .ai-wedge p{color:#CDD9CF;font-size:14.5px;max-width:52ch}
    .ai-price{font-family:var(--font-heading);font-size:26px;font-weight:600;text-align:right;white-space:nowrap}
    .ai-price span{display:block;font-family:var(--font-body);font-size:12px;color:#B9C6BC;font-weight:400}
    .ai-ladder{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}
    .ai-row{display:grid;grid-template-columns:40px 160px 100px 1fr;gap:16px;align-items:center;padding:16px 24px;border-top:1px solid var(--line)}
    .ai-row:first-child{border-top:none}
    .ai-row .ai-n{font-family:var(--font-heading);color:var(--gold);font-weight:600;font-size:15px}
    .ai-name{font-weight:500;font-size:15px}
    .ai-name small{display:block;color:var(--muted);font-size:12px;font-weight:400}
    .ai-p{font-family:var(--font-heading);font-weight:600;font-size:16px}
    .ai-p small{font-family:var(--font-body);color:var(--muted);font-size:12px;font-weight:400}
    .ai-d{color:var(--muted);font-size:13.5px}
    .ai-model{background:var(--sage);border-radius:var(--radius);padding:24px 28px;margin:26px 0 28px}
    .ai-model h4{font-family:var(--font-heading);font-weight:600;font-size:17px;margin:0 0 10px}
    .ai-model ol{margin:0;padding-left:20px;color:var(--muted);font-size:14.5px}
    .ai-model li{padding:3px 0}
    @media (max-width:860px){
      .tiers{grid-template-columns:1fr}
      .ai-wedge{grid-template-columns:1fr}
      .ai-price{text-align:left}
      .ai-row{grid-template-columns:1fr;gap:4px;padding:14px 20px}
    }
  </style>
</Base>

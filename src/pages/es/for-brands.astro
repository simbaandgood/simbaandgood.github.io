---
import Base from '../../layouts/Base.astro';

const title = 'Simba & Good para Marcas — Marketing, Producto e IA para Negocios de Mascotas';
const description = 'Simba & Good es el brazo de agencia que ayuda a crecer a negocios de mascotas: marketing, producto y diseño, y una línea de servicios de IA neutral que empieza con una Evaluación de Preparación en IA de $999.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Marketing, Product & Design, and AI Consulting for Pet Businesses',
  provider: { '@type': 'Organization', name: 'Simba & Good' },
  areaServed: 'Global',
  audience: { '@type': 'Audience', audienceType: 'Pet industry businesses' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI Services for Pet Businesses',
    itemListElement: [
      { '@type': 'Offer', name: 'AI Readiness Assessment', price: '999', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'AI Concierge (monthly)', price: '1500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Process Redesign', price: '3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Automation Builds', priceRange: '$2000-$3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Knowledge Systems', priceRange: '$3500+', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Custom Assistants', priceRange: '$4000-$6000', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Full AI Implementation', priceRange: '$10000-$18000+', priceCurrency: 'USD' },
    ],
  },
};
---
<Base title={title} description={description} path="/for-brands" lang="es" structuredData={serviceSchema}>
  <header class="hero"><div class="wrap">
    <span class="eyebrow">Para marcas · La agencia Simba &amp; Good</span>
    <h1>Marketing, producto e IA — hechos para el sector de mascotas.</h1>
    <p>Ayudamos a negocios de mascotas a crecer, modernizarse y verse a la altura — desde clínicas y peluquerías hasta alimento, retail y pet-tech. Liderado por gente de producto y diseño a la que también le encanta este sector.</p>
    <div class="who">
      <span>Veterinarias y clínicas</span><span>Peluquerías y hospedaje</span><span>Alimento y D2C</span>
      <span>Retail de mascotas</span><span>Pet-tech</span><span>Refugios y rescates</span>
    </div>
  </div></header>

  <section class="disc"><div class="wrap">
    <h2>Tres cosas que hacemos bien.</h2>
    <p>Elige uno o combínalos. Cada colaboración tiene un alcance mensual fijo — sin facturas sorpresa, sin contratos abiertos.</p>
  </div></section>

  <section class="wrap">
    <div class="tiers">
      <div class="tier">
        <span class="kind">Marketing · Esencial</span>
        <h3>Mantente visible</h3>
        <div class="price">$1,000<span style="font-size:16px">/mo</span></div>
        <span class="per">Mensual continuo · cancela cuando quieras</span>
        <ul><li>Contenido para redes, planificado y publicado</li><li>Campaña o promoción mensual</li><li>Soporte de diseño ligero para lo que necesites</li><li>Resumen simple de desempeño mensual</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Reserva una llamada</a>
      </div>
      <div class="tier feature">
        <span class="kind">Marketing · Crecimiento</span>
        <h3>Crece con intención</h3>
        <div class="price">$3,000<span style="font-size:16px">/mo</span></div>
        <span class="per">La más elegida para escalar marcas</span>
        <ul><li>Motor de contenido completo en todos los canales</li><li>Landing pages y diseño de campañas</li><li>Assets de marca y dirección creativa</li><li>Email / marketing de ciclo de vida</li><li>Sesión de estrategia mensual</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Reserva una llamada</a>
      </div>
      <div class="tier">
        <span class="kind">Producto y diseño</span>
        <h3>Construye algo grandioso</h3>
        <div class="price">desde $5,000<span style="font-size:16px">/mes</span></div>
        <span class="per">Para pet-tech y marcas centradas en producto</span>
        <ul><li>UX y UI para apps y sitios web</li><li>Estrategia de producto y roadmap</li><li>Sistemas de diseño y prototipos</li><li>Liderazgo senior de producto/diseño</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Reserva una llamada</a>
      </div>
    </div>

    <div class="note"><b>Trabajar con nosotros también financia la misión.</b> &nbsp;Una parte de todo lo que gana la agencia va al bienestar animal — así que hacer crecer tu negocio ayuda a animales más allá de tus propios clientes.</div>
  </section>

  <section class="ai-section"><div class="wrap">
    <span class="eyebrow">IA para negocios de mascotas</span>
    <h2>Empieza con el diagnóstico. Deja que revele el trabajo de mayor valor.</h2>
    <p class="ai-sub">Una línea de servicio neutral respecto al proveedor — construimos con la herramienta que mejor encaje, para que nunca dependas de un solo proveedor. Cada colaboración deja a tu equipo con herramientas de IA propias que pueden seguir usando sin nosotros.</p>

    <div class="ai-wedge">
      <span class="ai-n">01</span>
      <div>
        <h3>Evaluación de Preparación en IA <span class="star">★ empieza aquí</span></h3>
        <p>Una sesión de trabajo de 45 minutos → un mapa priorizado de 3 a 7 puntos donde la IA le ahorra horas reales a tu equipo (reservas, comunicación con clientes, inventario, contenido, reseñas). La mayoría de las evaluaciones revelan dos o tres proyectos de mayor valor.</p>
      </div>
      <div class="ai-price">$999<span>tarifa fija, se acredita hacia el siguiente paso</span></div>
    </div>

    <div class="ai-ladder">
      <div class="ai-row"><span class="ai-n">02</span><div class="ai-name">AI Concierge <small>retainer</small></div><div class="ai-p">$1,500<small>/mes</small></div><div class="ai-d">Dos llamadas de 45 min al mes, convertidas en asistentes de IA reutilizables que tu equipo realmente usa.</div></div>
      <div class="ai-row"><span class="ai-n">03</span><div class="ai-name">Rediseño de Procesos</div><div class="ai-p">$3,500</div><div class="ai-d">Tomamos un proceso doloroso de varios pasos y lo reducimos. Una clínica: proceso de admisión de 25 pasos → 10.</div></div>
      <div class="ai-row"><span class="ai-n">04</span><div class="ai-name">Automatizaciones</div><div class="ai-p">$2K–$3.5K</div><div class="ai-d">Conectamos las herramientas que ya usas en flujos automáticos — de la reserva al seguimiento, sin intervención manual.</div></div>
      <div class="ai-row"><span class="ai-n">05</span><div class="ai-name">Sistemas de Conocimiento</div><div class="ai-p">$3.5K+</div><div class="ai-d">Convertimos información dispersa — correos, protocolos, catálogos — en respuestas instantáneas y con la voz de tu marca.</div></div>
      <div class="ai-row"><span class="ai-n">06</span><div class="ai-name">Asistentes a Medida</div><div class="ai-p">$4K–$6K</div><div class="ai-d">Herramientas de IA hechas a medida para tu negocio. Una tarea de 45 minutos, reducida a 5.</div></div>
      <div class="ai-row"><span class="ai-n">07</span><div class="ai-name">Implementación Completa de IA</div><div class="ai-p">$10K–$18K+</div><div class="ai-d">Asistentes, automatizaciones y sistemas de conocimiento desplegados en todo el negocio, con capacitación incluida.</div></div>
    </div>

    <div class="ai-model">
      <h4>El modelo</h4>
      <ol><li>La evaluación es la línea base.</li><li>Nos anclamos en horas ahorradas, no horas trabajadas.</li><li>Eres dueño de lo que construimos — sin ataduras.</li></ol>
    </div>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Reserva la evaluación de $999</a>
  </div></section>

  <section><div class="cta">
    <h2>Hagamos crecer tu negocio de mascotas.</h2>
    <p>Cuéntanos en qué estás trabajando. Volveremos con un plan y un precio mensual fijo.</p>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Reserva una llamada</a>
  </div></section>

  <style>
    .hero{padding:72px 0 30px}
    .hero .eyebrow{color:var(--gold)}
    .hero h1{font-size:clamp(38px,5.2vw,60px);margin:16px 0 20px;max-width:16ch}
    .hero p{color:var(--muted);font-size:19px;max-width:50ch}
    .who{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
    .who span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13.5px;color:var(--muted)}
    .disc{padding:22px 0 8px}
    .disc h2{font-size:clamp(26px,3.4vw,38px)}
    .disc p{color:var(--muted);margin-top:12px;max-width:56ch;font-size:16.5px}
    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:38px 0 20px}
    .tier{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column}
    .tier.feature{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .tier .kind{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .tier h3{font-size:23px;margin:10px 0 6px;font-weight:500}
    .tier.feature h3{color:#fff}
    .tier .price{font-family:var(--font-heading);font-size:34px;font-weight:600;margin:8px 0 2px}
    .tier .per{font-size:13.5px;color:var(--muted)}
    .tier.feature .per{color:#B9C6BC}
    .tier ul{list-style:none;padding:0;margin:20px 0 0;flex:1}
    .tier li{font-size:14.5px;color:var(--muted);padding:7px 0 7px 22px;position:relative}
    .tier.feature li{color:#CDD9CF}
    .tier li:before{content:"🐾";position:absolute;left:0;font-size:12px;top:8px}
    .tier .btn{margin-top:22px;text-align:center}
    .tier.feature .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .note{background:var(--sage);border-radius:var(--radius);padding:26px 30px;margin:16px 0 40px;font-size:15.5px;color:var(--muted)}
    .note b{color:var(--ink);font-family:var(--font-heading)}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:52px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(26px,3.4vw,40px);max-width:20ch;margin:0 auto}
    .cta p{color:#C4D2C7;margin:14px auto 28px;max-width:46ch}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .ai-section{padding:20px 0 80px}
    .ai-section h2{font-size:clamp(26px,3.4vw,38px);max-width:22ch;margin-top:10px}
    .ai-sub{color:var(--muted);margin:14px 0 36px;max-width:56ch;font-size:16px}
    .ai-wedge{background:var(--forest-deep);color:#fff;border-radius:var(--radius);padding:26px 30px;display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;margin-bottom:14px}
    .ai-wedge .ai-n{font-family:var(--font-heading);font-size:22px;color:var(--gold);font-weight:600}
    .ai-wedge h3{color:#fff;font-size:19px;font-weight:500;margin:0 0 6px}
    .ai-wedge .star{color:var(--gold);font-size:12px;font-weight:600;letter-spacing:.05em;margin-left:6px}
    .ai-wedge p{color:#CDD9CF;font-size:14.5px;max-width:52ch}
    .ai-price{font-family:var(--font-heading);font-size:26px;font-weight:600;text-align:right;white-space:nowrap}
    .ai-price span{display:block;font-family:var(--font-body);font-size:12px;color:#B9C6BC;font-weight:400}
    .ai-ladder{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}
    .ai-row{display:grid;grid-template-columns:40px 160px 100px 1fr;gap:16px;align-items:center;padding:16px 24px;border-top:1px solid var(--line)}
    .ai-row:first-child{border-top:none}
    .ai-row .ai-n{font-family:var(--font-heading);color:var(--gold);font-weight:600;font-size:15px}
    .ai-name{font-weight:500;font-size:15px}
    .ai-name small{display:block;color:var(--muted);font-size:12px;font-weight:400}
    .ai-p{font-family:var(--font-heading);font-weight:600;font-size:16px}
    .ai-p small{font-family:var(--font-body);color:var(--muted);font-size:12px;font-weight:400}
    .ai-d{color:var(--muted);font-size:13.5px}
    .ai-model{background:var(--sage);border-radius:var(--radius);padding:24px 28px;margin:26px 0 28px}
    .ai-model h4{font-family:var(--font-heading);font-weight:600;font-size:17px;margin:0 0 10px}
    .ai-model ol{margin:0;padding-left:20px;color:var(--muted);font-size:14.5px}
    .ai-model li{padding:3px 0}
    @media (max-width:860px){
      .tiers{grid-template-columns:1fr}
      .ai-wedge{grid-template-columns:1fr}
      .ai-price{text-align:left}
      .ai-row{grid-template-columns:1fr;gap:4px;padding:14px 20px}
    }
  </style>
</Base>

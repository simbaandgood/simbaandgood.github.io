---
import Base from '../../layouts/Base.astro';
---
<Base title="No encontrado — Simba & Good" path="/404" description="Página no encontrada." lang="es">
  <section class="nf"><div class="wrap">
    <h1>404</h1>
    <p>Esa página se fue a pasear &mdash; como un perro que escuchó la palabra "paseo".</p>
    <a class="btn btn-primary" href="/">Volver al inicio</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>

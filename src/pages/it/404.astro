---
import Base from '../../layouts/Base.astro';
---
<Base title="Non trovata — Simba & Good" path="/404" description="Pagina non trovata." lang="it">
  <section class="nf"><div class="wrap">
    <h1>404</h1>
    <p>Questa pagina se n’è andata a spasso &mdash; come un cane che ha sentito la parola "passeggiata".</p>
    <a class="btn btn-primary" href="/">Torna alla home</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>

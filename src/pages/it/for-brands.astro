---
import Base from '../../layouts/Base.astro';

const title = 'Simba & Good per i brand — Marketing, prodotto e IA per aziende pet';
const description = "Simba & Good è il ramo agenzia che aiuta le aziende pet a crescere: marketing, prodotto e design, e una linea di servizi IA neutrale rispetto ai fornitori, a partire da una AI Readiness Assessment da $999.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Marketing, Product & Design, and AI Consulting for Pet Businesses',
  provider: { '@type': 'Organization', name: 'Simba & Good' },
  areaServed: 'Global',
  audience: { '@type': 'Audience', audienceType: 'Pet industry businesses' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI Services for Pet Businesses',
    itemListElement: [
      { '@type': 'Offer', name: 'AI Readiness Assessment', price: '999', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'AI Concierge (monthly)', price: '1500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Process Redesign', price: '3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Automation Builds', priceRange: '$2000-$3500', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Knowledge Systems', priceRange: '$3500+', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Custom Assistants', priceRange: '$4000-$6000', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Full AI Implementation', priceRange: '$10000-$18000+', priceCurrency: 'USD' },
    ],
  },
};
---
<Base title={title} description={description} path="/for-brands" lang="it" structuredData={serviceSchema}>
  <header class="hero"><div class="wrap">
    <span class="eyebrow">Per i brand · L’agenzia Simba &amp; Good</span>
    <h1>Marketing, prodotto e IA — pensati per il settore pet.</h1>
    <p>Aiutiamo le aziende pet a crescere, modernizzarsi e fare bella figura — da cliniche e toelettature a pet food, retail e pet-tech. Guidati da persone di prodotto e design che amano davvero questo settore.</p>
    <div class="who">
      <span>Veterinari e cliniche</span><span>Toelettature e pensioni</span><span>Pet food e D2C</span>
      <span>Retail per animali</span><span>Pet-tech</span><span>Rifugi e associazioni</span>
    </div>
  </div></header>

  <section class="disc"><div class="wrap">
    <h2>Tre cose che sappiamo fare bene.</h2>
    <p>Sceglierne uno, o combinarli. Ogni collaborazione ha uno scope mensile fisso — niente fatture a sorpresa, niente contratti aperti.</p>
  </div></section>

  <section class="wrap">
    <div class="tiers">
      <div class="tier">
        <span class="kind">Marketing · Essenziale</span>
        <h3>Resta visibile</h3>
        <div class="price">$1,000<span style="font-size:16px">/mo</span></div>
        <span class="per">Mensile ricorrente · annulla quando vuoi</span>
        <ul><li>Contenuti social, pianificati e pubblicati</li><li>Campagna o promozione mensile</li><li>Supporto design leggero per ciò che serve</li><li>Recap mensile semplice delle performance</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Prenota una call</a>
      </div>
      <div class="tier feature">
        <span class="kind">Marketing · Crescita</span>
        <h3>Crescere con metodo</h3>
        <div class="price">$3,000<span style="font-size:16px">/mo</span></div>
        <span class="per">La più scelta per far scalare i brand</span>
        <ul><li>Motore di contenuti completo su tutti i canali</li><li>Landing page e design delle campagne</li><li>Asset di brand e direzione creativa</li><li>Email / lifecycle marketing</li><li>Sessione di strategia mensile</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Prenota una call</a>
      </div>
      <div class="tier">
        <span class="kind">Prodotto e design</span>
        <h3>Costruisci qualcosa di grande</h3>
        <div class="price">da $5.000<span style="font-size:16px">/mese</span></div>
        <span class="per">Per pet-tech e brand product-led</span>
        <ul><li>UX e UI per app e siti web</li><li>Strategia di prodotto e roadmap</li><li>Design system e prototipi</li><li>Leadership senior di prodotto/design</li></ul>
        <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Prenota una call</a>
      </div>
    </div>

    <div class="note"><b>Lavorare con noi finanzia anche la missione.</b> &nbsp;Una parte di tutto ciò che guadagna l’agenzia va al benessere animale — quindi far crescere la tua attività aiuta animali oltre i tuoi stessi clienti.</div>
  </section>

  <section class="ai-section"><div class="wrap">
    <span class="eyebrow">IA per aziende pet</span>
    <h2>Inizia con la diagnosi. Lascia che riveli il lavoro a maggior valore.</h2>
    <p class="ai-sub">Una linea di servizio neutrale rispetto ai fornitori — costruiamo con lo strumento più adatto, così non resti mai legato a un unico fornitore. Ogni collaborazione lascia al tuo team strumenti IA di sua proprietà, utilizzabili anche senza di noi.</p>

    <div class="ai-wedge">
      <span class="ai-n">01</span>
      <div>
        <h3>AI Readiness Assessment <span class="star">★ inizia da qui</span></h3>
        <p>Una sessione di lavoro di 45 minuti → una mappa prioritizzata di 3-7 punti in cui l’IA fa risparmiare ore reali al tuo team (prenotazioni, comunicazione clienti, inventario, contenuti, recensioni). La maggior parte delle valutazioni fa emergere due o tre progetti a maggior valore.</p>
      </div>
      <div class="ai-price">$999<span>tariffa fissa, scalata dal passo successivo</span></div>
    </div>

    <div class="ai-ladder">
      <div class="ai-row"><span class="ai-n">02</span><div class="ai-name">AI Concierge <small>retainer</small></div><div class="ai-p">$1.500<small>/mese</small></div><div class="ai-d">Due call da 45 minuti al mese, trasformate in assistenti IA riutilizzabili che il tuo team usa davvero.</div></div>
      <div class="ai-row"><span class="ai-n">03</span><div class="ai-name">Ridisegno di Processo</div><div class="ai-p">$3.500</div><div class="ai-d">Prendiamo un processo lungo e doloroso e lo snelliamo. Una clinica: accettazione in 25 passaggi → 10.</div></div>
      <div class="ai-row"><span class="ai-n">04</span><div class="ai-name">Automazioni</div><div class="ai-p">$2K–$3,5K</div><div class="ai-d">Colleghiamo gli strumenti che già usi in flussi automatici — dalla prenotazione al follow-up, in automatico.</div></div>
      <div class="ai-row"><span class="ai-n">05</span><div class="ai-name">Sistemi di Conoscenza</div><div class="ai-p">$3,5K+</div><div class="ai-d">Trasformiamo informazioni sparse — email, protocolli, cataloghi — in risposte istantanee e coerenti col tuo brand.</div></div>
      <div class="ai-row"><span class="ai-n">06</span><div class="ai-name">Assistenti Su Misura</div><div class="ai-p">$4K–$6K</div><div class="ai-d">Strumenti IA costruiti su misura per la tua attività. Un’attività da 45 minuti, ridotta a 5.</div></div>
      <div class="ai-row"><span class="ai-n">07</span><div class="ai-name">Implementazione IA Completa</div><div class="ai-p">$10K–$18K+</div><div class="ai-d">Assistenti, automazioni e sistemi di conoscenza distribuiti in tutta l’azienda, con formazione inclusa.</div></div>
    </div>

    <div class="ai-model">
      <h4>Il modello</h4>
      <ol><li>La valutazione è la base di partenza.</li><li>Ci concentriamo sulle ore risparmiate, non su quelle lavorate.</li><li>Sei proprietario di ciò che costruiamo — nessun lock-in.</li></ol>
    </div>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Prenota la valutazione da $999</a>
  </div></section>

  <section><div class="cta">
    <h2>Facciamo crescere la tua attività pet.</h2>
    <p>Raccontaci a cosa stai lavorando. Torneremo con un piano e un prezzo mensile fisso.</p>
    <a class="btn btn-primary" href="https://calendly.com/piyushsinha/simba-and-good-for-brands-intro-call">Prenota una call</a>
  </div></section>

  <style>
    .hero{padding:72px 0 30px}
    .hero .eyebrow{color:var(--gold)}
    .hero h1{font-size:clamp(38px,5.2vw,60px);margin:16px 0 20px;max-width:16ch}
    .hero p{color:var(--muted);font-size:19px;max-width:50ch}
    .who{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
    .who span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13.5px;color:var(--muted)}
    .disc{padding:22px 0 8px}
    .disc h2{font-size:clamp(26px,3.4vw,38px)}
    .disc p{color:var(--muted);margin-top:12px;max-width:56ch;font-size:16.5px}
    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:38px 0 20px}
    .tier{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column}
    .tier.feature{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .tier .kind{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .tier h3{font-size:23px;margin:10px 0 6px;font-weight:500}
    .tier.feature h3{color:#fff}
    .tier .price{font-family:var(--font-heading);font-size:34px;font-weight:600;margin:8px 0 2px}
    .tier .per{font-size:13.5px;color:var(--muted)}
    .tier.feature .per{color:#B9C6BC}
    .tier ul{list-style:none;padding:0;margin:20px 0 0;flex:1}
    .tier li{font-size:14.5px;color:var(--muted);padding:7px 0 7px 22px;position:relative}
    .tier.feature li{color:#CDD9CF}
    .tier li:before{content:"🐾";position:absolute;left:0;font-size:12px;top:8px}
    .tier .btn{margin-top:22px;text-align:center}
    .tier.feature .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .note{background:var(--sage);border-radius:var(--radius);padding:26px 30px;margin:16px 0 40px;font-size:15.5px;color:var(--muted)}
    .note b{color:var(--ink);font-family:var(--font-heading)}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:52px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(26px,3.4vw,40px);max-width:20ch;margin:0 auto}
    .cta p{color:#C4D2C7;margin:14px auto 28px;max-width:46ch}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .ai-section{padding:20px 0 80px}
    .ai-section h2{font-size:clamp(26px,3.4vw,38px);max-width:22ch;margin-top:10px}
    .ai-sub{color:var(--muted);margin:14px 0 36px;max-width:56ch;font-size:16px}
    .ai-wedge{background:var(--forest-deep);color:#fff;border-radius:var(--radius);padding:26px 30px;display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;margin-bottom:14px}
    .ai-wedge .ai-n{font-family:var(--font-heading);font-size:22px;color:var(--gold);font-weight:600}
    .ai-wedge h3{color:#fff;font-size:19px;font-weight:500;margin:0 0 6px}
    .ai-wedge .star{color:var(--gold);font-size:12px;font-weight:600;letter-spacing:.05em;margin-left:6px}
    .ai-wedge p{color:#CDD9CF;font-size:14.5px;max-width:52ch}
    .ai-price{font-family:var(--font-heading);font-size:26px;font-weight:600;text-align:right;white-space:nowrap}
    .ai-price span{display:block;font-family:var(--font-body);font-size:12px;color:#B9C6BC;font-weight:400}
    .ai-ladder{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff}
    .ai-row{display:grid;grid-template-columns:40px 160px 100px 1fr;gap:16px;align-items:center;padding:16px 24px;border-top:1px solid var(--line)}
    .ai-row:first-child{border-top:none}
    .ai-row .ai-n{font-family:var(--font-heading);color:var(--gold);font-weight:600;font-size:15px}
    .ai-name{font-weight:500;font-size:15px}
    .ai-name small{display:block;color:var(--muted);font-size:12px;font-weight:400}
    .ai-p{font-family:var(--font-heading);font-weight:600;font-size:16px}
    .ai-p small{font-family:var(--font-body);color:var(--muted);font-size:12px;font-weight:400}
    .ai-d{color:var(--muted);font-size:13.5px}
    .ai-model{background:var(--sage);border-radius:var(--radius);padding:24px 28px;margin:26px 0 28px}
    .ai-model h4{font-family:var(--font-heading);font-weight:600;font-size:17px;margin:0 0 10px}
    .ai-model ol{margin:0;padding-left:20px;color:var(--muted);font-size:14.5px}
    .ai-model li{padding:3px 0}
    @media (max-width:860px){
      .tiers{grid-template-columns:1fr}
      .ai-wedge{grid-template-columns:1fr}
      .ai-price{text-align:left}
      .ai-row{grid-template-columns:1fr;gap:4px;padding:14px 20px}
    }
  </style>
</Base>

---
import Base from '../../layouts/Base.astro';
---
<Base title="Nicht gefunden — Simba & Good" path="/404" description="Seite nicht gefunden." lang="de">
  <section class="nf"><div class="wrap">
    <h1>404</h1>
    <p>Diese Seite ist einfach losgezogen &mdash; wie ein Hund, der "Gassi" gehört hat.</p>
    <a class="btn btn-primary" href="/">Zurück zur Startseite</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>

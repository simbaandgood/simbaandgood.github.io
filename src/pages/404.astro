---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Simba & Good" path="/404" description="Page not found.">
  <section class="nf"><div class="wrap">
    <h1>404</h1>
    <p>That page has wandered off &mdash; like a dog that heard &ldquo;walk&rdquo;.</p>
    <a class="btn btn-primary" href="/">Back home</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>

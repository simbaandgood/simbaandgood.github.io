---
import Base from '../layouts/Base.astro';

const title = 'Simba & Good — Better care for the pets we love, and the ones who need it';
const description = 'Simba & Good is a pet-industry company: Seasons, a pet lifecycle app; Shop for Good, a mission-driven storefront; and an agency for pet businesses — all funding animal welfare.';
---
<Base title={title} description={description} path="/">
  <header class="hero"><div class="wrap">
    <span class="eyebrow">Simba &amp; Good</span>
    <h1>Better care for the pets we love. Real help for the ones who don't have anyone yet.</h1>
    <p class="lead">We build a pet lifecycle app, a mission-driven storefront, and an agency for pet businesses — three different ways in, one shared purpose: everyday pet care that funds animal welfare.</p>
  </div></header>

  <section class="funnel"><div class="wrap">
    <div class="offer">
      <span class="tag">The app</span>
      <h2>Seasons</h2>
      <p>A pet lifecycle app that knows your pet's breed and age, and guides you through what matters at each stage — vaccinations, nutrition, health checks, and the milestones in between.</p>
      <a class="btn btn-primary" href="/seasons">Explore Seasons →</a>
    </div>
    <div class="offer offer-dark">
      <span class="tag">The storefront</span>
      <h2>Shop for Good</h2>
      <p>Practical, beautifully made digital guides and templates for every stage of your pet's life — instant downloads, and every purchase helps fund animal welfare.</p>
      <a class="btn btn-primary" href="/shop">Visit the shop →</a>
    </div>
    <div class="offer">
      <span class="tag">The agency</span>
      <h2>For Brands</h2>
      <p>Marketing, product &amp; design, and provider-neutral AI — built for the pet industry. Fixed monthly scope, no surprise invoices.</p>
      <a class="btn btn-primary" href="/for-brands">See our services →</a>
    </div>
  </div></section>

  <section class="mission" id="mission"><div class="wrap mission-grid">
    <div>
      <span class="eyebrow">The mission</span>
      <h2>Everyday work that gives back.</h2>
      <p>Simba &amp; Good exists to make caring for pets easier — and to turn healthy products and businesses into real support for the animals who have no one. Rescue, veterinary care, and rehoming for strays and shelter animals. Every part of what we build funds giving from day one, and it grows from there.</p>
      <span class="pill">🐾 Openly reported, every year.</span>
      <div class="mission-link"><a href="/welfare-plan">Read our full welfare plan →</a></div>
    </div>
    <div>
      <div class="give">70%</div>
      <div class="give-label">is our goal for the share of profits going to animal welfare, over time.</div>
    </div>
  </div></section>

  <section class="simba" id="simba"><div class="wrap">
    <img src="/images/Simba.jpg" alt="Simba, a Bichon Frise and the heart of Simba &amp; Good" class="simba-photo" />
    <span class="eyebrow">Our story</span>
    <h2>It started with a small white dog named Simba.</h2>
    <p>Simba is my Bichon Frise — healthy, spoiled, and the reason this company exists. Caring for him well meant staying on top of a hundred small things at the right time, and it made me wonder why that was so hard. It also made the gap impossible to ignore: the strays and rescues with no one keeping track of any of it. Simba &amp; Good is the answer to both — better care for the pets we love, and real support for the ones still waiting for someone.</p>
  </div></section>

  <section><div class="cta">
    <h2>Pick where you'd like to start.</h2>
    <p>Whether you're here for your own pet, a gift, or your business — there's a place for you.</p>
    <div class="cta-links">
      <a class="btn btn-primary" href="/seasons">Seasons app</a>
      <a class="btn btn-ghost-dark" href="/shop">Shop for Good</a>
      <a class="btn btn-ghost-dark" href="/for-brands">For brands</a>
    </div>
  </div></section>

  <style>
    .hero{padding:88px 0 70px;text-align:center}
    .hero .eyebrow{color:var(--gold);display:block}
    .hero h1{font-size:clamp(34px,5vw,54px);margin:18px auto 22px;max-width:20ch}
    .hero .lead{font-size:18.5px;color:var(--muted);max-width:56ch;margin:0 auto}
    .funnel{padding:10px 0 80px}
    .funnel .wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .offer{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:34px;display:flex;flex-direction:column}
    .offer-dark{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .offer .tag{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .offer h2{font-family:"Fraunces",serif;font-size:28px;font-weight:600;margin:12px 0 10px}
    .offer-dark h2{color:#fff}
    .offer p{color:var(--muted);font-size:15px;flex:1;margin-bottom:24px}
    .offer-dark p{color:#CDD9CF}
    .offer .btn{align-self:flex-start}
    .offer-dark .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .mission{background:var(--sage);padding:78px 0}
    .mission-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
    .mission h2{font-size:clamp(26px,3.4vw,38px);max-width:16ch}
    .mission p{color:var(--muted);margin-top:18px;font-size:16.5px;max-width:46ch}
    .give{font-family:"Fraunces",serif;font-size:clamp(40px,6vw,72px);color:var(--forest);font-weight:600;line-height:1;margin-top:8px}
    .give-label{color:var(--muted);font-size:15px;margin-top:6px}
    .mission .pill{display:inline-flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:14px;font-weight:500;margin-top:24px}
    .mission-link{margin-top:22px}
    .mission-link a{color:var(--forest);font-weight:600;text-decoration:none}
    .simba{padding:82px 0;text-align:center}
    .simba-photo{width:100%;max-width:480px;aspect-ratio:4/3;border-radius:var(--radius);object-fit:cover;object-position:62% 42%;display:block;margin:0 auto 32px;box-shadow:0 24px 50px -24px rgba(23,50,41,.4)}
    .simba h2{font-size:clamp(26px,3.4vw,38px);max-width:20ch;margin:16px auto 0}
    .simba p{color:var(--muted);max-width:58ch;margin:20px auto 0;font-size:16.5px}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:56px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(28px,3.6vw,42px);max-width:20ch;margin:0 auto}
    .cta p{color:#C4D2C7;margin:16px auto 30px;max-width:44ch}
    .cta-links{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .cta .btn-primary:hover{box-shadow:0 8px 22px rgba(201,146,66,.35)}
    .btn-ghost-dark{border:1px solid rgba(255,255,255,.35);color:#fff;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:600;font-size:15px}
    .btn-ghost-dark:hover{background:rgba(255,255,255,.08)}
    @media (max-width:860px){
      .funnel .wrap,.mission-grid{grid-template-columns:1fr}
    }
  </style>
</Base>

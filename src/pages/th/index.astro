---
import Base from '../../layouts/Base.astro';

const title = 'Simba & Good — ดูแลสัตว์เลี้ยงที่เรารักให้ดียิ่งขึ้น';
const description = 'Simba & Good คือบริษัทในอุตสาหกรรมสัตว์เลี้ยง ประกอบด้วย Seasons แอปดูแลสัตว์เลี้ยงตลอดช่วงชีวิต, Shop for Good ร้านค้าที่มีเป้าหมายเพื่อสังคม, เอเจนซี่สำหรับธุรกิจสัตว์เลี้ยง และบริการให้คำปรึกษาสถานที่ที่เป็นมิตรกับสัตว์เลี้ยง — ทั้งหมดเพื่อสนับสนุนสวัสดิภาพสัตว์';
---
<Base title={title} description={description} path="/" lang="th">
  <header class="hero"><div class="wrap">
    <span class="eyebrow">Simba &amp; Good</span>
    <h1>ดูแลสัตว์เลี้ยงที่เรารักให้ดียิ่งขึ้น ช่วยเหลือตัวที่ยังไม่มีใครดูแลอย่างแท้จริง</h1>
    <p class="lead">เราสร้างแอปดูแลสัตว์เลี้ยงตลอดช่วงชีวิต ร้านค้าที่มีเป้าหมายเพื่อสังคม เอเจนซี่สำหรับธุรกิจสัตว์เลี้ยง และบริการให้คำปรึกษาสถานที่ที่เป็นมิตรกับสัตว์เลี้ยง — สี่ช่องทางที่แตกต่างกัน แต่มีเป้าหมายเดียวกัน คือการดูแลสัตว์เลี้ยงในชีวิตประจำวันที่ช่วยสนับสนุนสวัสดิภาพสัตว์</p>
  </div></header>

  <section class="funnel"><div class="wrap">
    <div class="offer">
      <span class="tag">แอป</span>
      <h2>Seasons</h2>
      <p>แอปดูแลสัตว์เลี้ยงตลอดช่วงชีวิตที่รู้จักสายพันธุ์และอายุของสัตว์เลี้ยงคุณ พร้อมแนะนำสิ่งสำคัญในแต่ละช่วงวัย ไม่ว่าจะเป็นวัคซีน โภชนาการ การตรวจสุขภาพ และเหตุการณ์สำคัญระหว่างทาง</p>
      <a class="btn btn-primary" href="/th/seasons">สำรวจ Seasons →</a>
    </div>
    <div class="offer offer-dark">
      <span class="tag">ร้านค้า</span>
      <h2>Shop for Good</h2>
      <p>คู่มือและเทมเพลตดิจิทัลที่ใช้งานได้จริงและออกแบบมาอย่างดีสำหรับทุกช่วงชีวิตของสัตว์เลี้ยงคุณ ดาวน์โหลดได้ทันที และทุกการซื้อช่วยสนับสนุนสวัสดิภาพสัตว์</p>
      <a class="btn btn-primary" href="/th/shop">เยี่ยมชมร้านค้า →</a>
    </div>
    <div class="offer">
      <span class="tag">เอเจนซี่</span>
      <h2>สำหรับแบรนด์</h2>
      <p>การตลาด ผลิตภัณฑ์และดีไซน์ รวมถึง AI ที่เป็นกลางไม่ผูกติดผู้ให้บริการรายใดรายหนึ่ง ออกแบบมาเพื่ออุตสาหกรรมสัตว์เลี้ยงโดยเฉพาะ ขอบเขตงานรายเดือนที่ตายตัว ไม่มีบิลที่คาดไม่ถึง</p>
      <a class="btn btn-primary" href="/th/for-brands">ดูบริการของเรา →</a>
    </div>
    <div class="offer offer-dark">
      <span class="tag">สถานที่จริง</span>
      <h2>สำหรับสถานที่</h2>
      <p>ตรวจประเมินความเป็นมิตรกับสัตว์เลี้ยง ปรับปรุงแก้ไขจริง และตราสัญลักษณ์รับรองที่ผ่านการตรวจสอบ — สำหรับคาเฟ่ โรงแรม ร้านค้าปลีก สำนักงาน และอื่น ๆ</p>
      <a class="btn btn-primary" href="/th/for-venues">ดูบริการของเรา →</a>
    </div>
  </div></section>

  <section class="mission" id="mission"><div class="wrap mission-grid">
    <div>
      <span class="eyebrow">พันธกิจ</span>
      <h2>งานที่ทำทุกวันเพื่อส่งต่อสิ่งดี ๆ กลับคืน</h2>
      <p>Simba &amp; Good มีอยู่เพื่อให้การดูแลสัตว์เลี้ยงเป็นเรื่องง่ายขึ้น และเปลี่ยนผลิตภัณฑ์และธุรกิจที่ดีต่อสุขภาพให้กลายเป็นความช่วยเหลือที่แท้จริงสำหรับสัตว์ที่ไม่มีใครดูแล ทั้งการช่วยเหลือ การรักษาทางสัตวแพทย์ และการหาบ้านใหม่ให้สัตว์จรจัดและสัตว์ในสถานสงเคราะห์ ทุกส่วนที่เราสร้างขึ้นสนับสนุนการให้ตั้งแต่วันแรก และเติบโตขึ้นเรื่อย ๆ</p>
      <span class="pill">🐾 รายงานอย่างเปิดเผยทุกปี</span>
      <div class="mission-link"><a href="/th/welfare-plan">อ่านแผนสวัสดิภาพสัตว์ฉบับเต็มของเรา →</a></div>
    </div>
    <div>
      <div class="give">70%</div>
      <div class="give-label">คือเป้าหมายของเราสำหรับสัดส่วนกำไรที่จะมอบให้สวัสดิภาพสัตว์ เมื่อเวลาผ่านไป</div>
    </div>
  </div></section>

  <section class="simba" id="simba"><div class="wrap">
    <img src="/images/Simba.jpg" alt="Simba สุนัขพันธุ์บิชอง ฟรีเซ่ และหัวใจของ Simba &amp; Good" class="simba-photo" />
    <span class="eyebrow">เรื่องราวของเรา</span>
    <h2>ทุกอย่างเริ่มต้นจากสุนัขสีขาวตัวเล็กชื่อ Simba</h2>
    <p>Simba คือสุนัขพันธุ์บิชอง ฟรีเซ่ของฉัน แข็งแรง ได้รับการตามใจ และเป็นเหตุผลที่บริษัทนี้เกิดขึ้น การดูแลเขาให้ดีหมายถึงการใส่ใจเรื่องเล็ก ๆ นับร้อยอย่างในเวลาที่เหมาะสม และนั่นทำให้ฉันสงสัยว่าทำไมมันถึงยากขนาดนี้ มันยังทำให้มองข้ามช่องว่างนั้นไม่ได้อีกต่อไป นั่นคือสัตว์จรจัดและสัตว์ในสถานสงเคราะห์ที่ไม่มีใครคอยดูแล Simba &amp; Good คือคำตอบของทั้งสองเรื่องนี้ — การดูแลสัตว์เลี้ยงที่เรารักให้ดียิ่งขึ้น และความช่วยเหลือที่แท้จริงสำหรับตัวที่ยังรอใครสักคนอยู่</p>
  </div></section>

  <section><div class="cta">
    <h2>เลือกจุดเริ่มต้นที่คุณต้องการ</h2>
    <p>ไม่ว่าจะมาเพื่อสัตว์เลี้ยงของคุณ ของขวัญ หรือธุรกิจของคุณ — ที่นี่มีทางเลือกสำหรับคุณ</p>
    <div class="cta-links">
      <a class="btn btn-primary" href="/th/seasons">แอป Seasons</a>
      <a class="btn btn-ghost-dark" href="/th/shop">Shop for Good</a>
      <a class="btn btn-ghost-dark" href="/th/for-brands">สำหรับแบรนด์</a>
      <a class="btn btn-ghost-dark" href="/th/for-venues">สำหรับสถานที่</a>
    </div>
  </div></section>

  <style>
    .hero{padding:88px 0 70px;text-align:center}
    .hero .eyebrow{color:var(--gold);display:block}
    .hero h1{font-size:clamp(30px,4.6vw,48px);margin:18px auto 22px;max-width:22ch}
    .hero .lead{font-size:18px;color:var(--muted);max-width:58ch;margin:0 auto}
    .funnel{padding:10px 0 80px}
    .funnel .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
    .offer{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px;display:flex;flex-direction:column}
    .offer-dark{background:var(--forest-deep);color:#fff;border-color:var(--forest-deep)}
    .offer .tag{font-size:12px;letter-spacing:.06em;color:var(--gold);font-weight:600}
    .offer h2{font-family:var(--font-heading);font-size:22px;font-weight:600;margin:12px 0 10px;line-height:1.3}
    .offer-dark h2{color:#fff}
    .offer p{color:var(--muted);font-size:15px;flex:1;margin-bottom:24px;line-height:1.7}
    .offer-dark p{color:#CDD9CF}
    .offer .btn{align-self:flex-start}
    .offer-dark .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .mission{background:var(--sage);padding:78px 0}
    .mission-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
    .mission h2{font-size:clamp(24px,3.2vw,34px);max-width:18ch;line-height:1.3}
    .mission p{color:var(--muted);margin-top:18px;font-size:16px;max-width:46ch;line-height:1.75}
    .give{font-family:var(--font-heading);font-size:clamp(38px,5.6vw,64px);color:var(--forest);font-weight:600;line-height:1.15;margin-top:8px}
    .give-label{color:var(--muted);font-size:15px;margin-top:6px;line-height:1.6}
    .mission .pill{display:inline-flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:14px;font-weight:500;margin-top:24px}
    .mission-link{margin-top:22px}
    .mission-link a{color:var(--forest);font-weight:600;text-decoration:none}
    .simba{padding:82px 0;text-align:center}
    .simba-photo{width:100%;max-width:480px;aspect-ratio:4/3;border-radius:var(--radius);object-fit:cover;object-position:62% 42%;display:block;margin:0 auto 32px;box-shadow:0 24px 50px -24px rgba(23,50,41,.4)}
    .simba h2{font-size:clamp(24px,3.2vw,34px);max-width:22ch;margin:16px auto 0;line-height:1.3}
    .simba p{color:var(--muted);max-width:58ch;margin:20px auto 0;font-size:16px;line-height:1.75}
    .cta{background:var(--forest);color:#fff;border-radius:26px;padding:56px;text-align:center;margin:0 auto 80px;max-width:var(--wrap)}
    .cta h2{color:#fff;font-size:clamp(26px,3.4vw,38px);max-width:20ch;margin:0 auto;line-height:1.3}
    .cta p{color:#C4D2C7;margin:16px auto 30px;max-width:44ch}
    .cta-links{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .cta .btn-primary{background:var(--gold);color:var(--forest-deep)}
    .cta .btn-primary:hover{box-shadow:0 8px 22px rgba(201,146,66,.35)}
    .btn-ghost-dark{border:1px solid rgba(255,255,255,.35);color:#fff;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:600;font-size:15px}
    .btn-ghost-dark:hover{background:rgba(255,255,255,.08)}
    @media (max-width:980px){
      .funnel .wrap{grid-template-columns:repeat(2,1fr)}
    }
    @media (max-width:640px){
      .funnel .wrap{grid-template-columns:1fr}
    }
    @media (max-width:860px){
      .mission-grid{grid-template-columns:1fr}
    }
  </style>
</Base>

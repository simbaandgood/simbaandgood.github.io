---
import Base from '../../layouts/Base.astro';
---
<Base title="Não encontrado — Simba & Good" path="/404" description="Página não encontrada." lang="pt">
  <section class="nf"><div class="wrap">
    <h1>404</h1>
    <p>Essa página saiu andando por aí &mdash; feito um cachorro que ouviu "passeio".</p>
    <a class="btn btn-primary" href="/">Voltar ao início</a>
  </div></section>
  <style>
    .nf{padding:120px 0;text-align:center}
    .nf h1{font-size:72px;color:var(--forest)}
    .nf p{color:var(--muted);margin:12px 0 24px}
  </style>
</Base>
